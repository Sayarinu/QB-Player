
# Queen's Blood AI - Environment Configuration

# DEVICE
# Select the computing device for the Neural Network.
# Options:
#   cpu    : Force use of CPU (slowest, most compatible)
#   cuda   : Use NVIDIA GPU (requires CUDA drivers)
#   mps    : Use Apple Silicon GPU (Mac M1/M2/M3/M4)
#   auto   : Automatically detect best available device
DEVICE=auto
